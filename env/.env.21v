# This file contains non-secret settings for local debugging against Azure operated by 21Vianet.

TEAMSFX_ENV=21v
APP_NAME_SUFFIX=21v

# Runtime
BOT_CLOUD=china
BOT_TYPE=SingleTenant
OPENAI_MODEL_NAME=gpt-5-mini

# Teams app and tunnel values are intentionally kept in env/.env.21v.user.

# Optional override for legacy multi-tenant bots in 21V.
# Leave empty for single-tenant bots.
BOT_AUTHORITY_TENANT=