# Copy this file to env/.env.21v.user and fill with your own values.
# This file is safe to commit because all values are placeholders.

# Teams app package and tunnel values (user/local specific)
TEAMS_APP_ID=<your-teams-app-id-guid>
BOT_ID=<your-bot-app-id-guid>
BOT_DOMAIN=<your-dev-tunnel-domain>
BOT_ENDPOINT=https://<your-dev-tunnel-domain>

# Bot runtime credentials
CLIENT_ID=<your-bot-app-client-id-guid>
TENANT_ID=<your-tenant-id-guid>
CLIENT_SECRET=<your-client-secret>

# Model access
OPENAI_API_KEY=<your-openai-api-key>

# Optional overrides when your bot registration uses non-default values.
# BOT_AUTHORITY_HOST=https://login.chinacloudapi.cn
# BOT_OAUTH_URL=https://token.botframework.azure.cn
# BOT_TO_CHANNEL_FROM_BOT_LOGIN_URL=https://login.partner.microsoftonline.cn/<tenant-id-or-domain>
# BOT_TO_CHANNEL_FROM_BOT_OAUTH_SCOPE=https://api.botframework.azure.cn
# BOT_TO_BOT_FROM_CHANNEL_TOKEN_ISSUER=https://api.botframework.azure.cn
# BOT_TO_BOT_FROM_CHANNEL_JWKS_URI=https://login.botframework.azure.cn/v1/.well-known/keys
